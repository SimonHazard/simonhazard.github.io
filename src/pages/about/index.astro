---
import Base from "@/layouts/Base.astro";
import Barcode from "@/components/custom/Barcode.astro";
import { t } from "@/i18n/utils";
---

<Base title={t("about.title")} description={t("about.description")}>
  <div class="animate-slide-up about-page">
    <header class="page-heading"><p class="eyebrow">Behind the projects</p><h1>{t("about.title")}</h1></header>

    <div class="flex items-center gap-3 mb-6">
      <Barcode />
      <span class="label-ui text-muted-foreground">{t("about.bio")}</span>
    </div>

    <div class="space-y-4 text-foreground leading-relaxed">
      <p>{t("about.p1")}</p>
      <p>{t("about.p2")}</p>
      <p>{t("about.p3")}</p>
    </div>

    <div class="mt-12">
      <div class="flex items-center gap-3 mb-6">
        <Barcode />
        <span class="label-ui text-muted-foreground">{t("about.contact")}</span>
      </div>

      <div class="flex flex-wrap gap-4">
        <a
          href="https://github.com/SimonHazard"
          target="_blank"
          rel="noopener noreferrer"
          class="button button-quiet"
          aria-label="GitHub profile"
        >
          GitHub
        </a>
        <a
          href="/static/simon-hazard.pdf"
          download
          class="button button-primary"
        >
          {t("home.downloadCV")}
        </a>
      </div>
    </div>
  </div>
</Base>
