---
import Base from "@/layouts/Base.astro";
import ArticleCard from "@/components/custom/ArticleCard.astro";
import ProjectCard from "@/components/custom/ProjectCard.astro";
import Orbital from "@/components/custom/Orbital.astro";
import Barcode from "@/components/custom/Barcode.astro";
import { getCollection } from "astro:content";
import { ArrowUpRight, ArrowDown, ArrowRight } from "@lucide/astro";
import { t } from "@/i18n/utils";
import { sortByDate } from "@/lib/utils";

const [allArticles, featuredProjects] = await Promise.all([
  getCollection("articles", ({ data }) => !data.draft),
  getCollection("projects", ({ data }) => data.featured),
]);
const latestArticles = sortByDate(allArticles).slice(0, 3);
---

<Base title="Web developer & maker" description="Independent projects, useful tools, and field notes on building for the web. Explore Simon Hazard’s portfolio.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-topline label-ui"><span><i class="status-dot"></i> Web developer / TypeScript</span><span class="hero-edition">Personal portfolio · {new Date().getFullYear()}</span></div>
    <div class="hero-body">
      <div class="hero-copy">
        <h1 id="hero-title" class="hero-title">SIMON<span>HAZARD<span class="name-period" aria-hidden="true">✳</span></span></h1>
        <p class="hero-description">Useful tools.<br /><span>A playful state of mind.</span></p>
        <p class="hero-intro">I build for the web and beyond. A collection of independent projects, experiments, and things learned along the way.</p>
        <div class="hero-actions">
          <a href="#selected-work" class="button button-primary">Explore my work <ArrowDown size={16} /></a>
          <a href="/static/simon-hazard.pdf" download class="button button-quiet">{t("home.downloadCV")} <ArrowUpRight size={16} /></a>
        </div>
      </div>
      <Orbital />
    </div>
    <div class="hero-bottom"><button class="motion-toggle label-ui" data-motion-toggle aria-pressed="false" hidden><span data-motion-label>Pause motion</span><span aria-hidden="true">Ⅱ</span></button></div>
  </section>

  <section id="selected-work" class="portfolio-section" aria-labelledby="work-title">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">From idea to release</p><h2 id="work-title">Selected work<span class="section-count">/{String(featuredProjects.length).padStart(2, "0")}</span></h2></div>
      <a href="/projects" class="text-link">All projects <ArrowUpRight size={16} /></a>
    </div>
    <div class="project-grid">
      {featuredProjects.map((project) => <ProjectCard {...project.data} />)}
    </div>
  </section>

  <section class="portfolio-section journal-section" aria-labelledby="journal-title">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">Notes from the process</p><h2 id="journal-title">Field notes<span class="section-count">/ Blog</span></h2></div>
      <a href="/articles" class="text-link">All articles <ArrowUpRight size={16} /></a>
    </div>
    <div class="journal-list">
      {latestArticles.map((article) => <ArticleCard {...article.data} href={`/articles/${article.id}`} />)}
    </div>
  </section>

  <section class="about-strip" data-reveal>
    <div><Barcode /><p class="eyebrow">The person behind the projects</p></div>
    <div><h2>Curiosity is the common thread.</h2><p>Front-end development, open-source tools, video games and board games. I like understanding how things work — then making something of my own.</p><a href="/about" class="text-link">A little more about me <ArrowRight size={16} /></a></div>
  </section>
</Base>
