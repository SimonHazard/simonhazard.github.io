---
import NavBar from "@/components/custom/NavBar.astro";
import Footer from "@/components/custom/Footer.astro";
import "@/styles/global.css";
import { t } from "@/i18n/utils";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = t("meta.defaultDescription"), ogImage } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = new URL(ogImage || "/icon-512.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} — Simon Hazard</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} — Simon Hazard`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Simon Hazard`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="icon" href="/favicon.ico?v=sh-monogram" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-sh-32.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon-sh.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=sh-monogram" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      try {
        document.documentElement.classList.toggle("dark", localStorage.getItem("theme") === "dark");
      } catch { /* Light is the default when storage is unavailable. */ }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <NavBar />
    <main id="main-content" tabindex="-1" class="site-main flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "@/scripts/motion";
    </script>
  </body>
</html>
