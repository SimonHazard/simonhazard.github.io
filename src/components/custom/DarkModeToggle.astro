---
import { Sun, Moon } from "@lucide/astro";
---
<button data-theme-toggle class="icon-button theme-toggle" aria-label="Switch to dark theme">
  <Sun class="sun size-4" /><Moon class="moon size-4" />
</button>
<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  function syncLabel() {
    toggle?.setAttribute("aria-label", document.documentElement.classList.contains("dark") ? "Switch to light theme" : "Switch to dark theme");
  }
  syncLabel();
  toggle?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch { /* Theme remains usable without storage. */ }
    syncLabel();
  });
</script>
