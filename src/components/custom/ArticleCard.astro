---
import { formatDate } from "@/lib/utils";
import { t } from "@/i18n/utils";
import { ArrowUpRight } from "@lucide/astro";
interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  tags: string[];
  lang: "fr" | "en";
  href: string;
  ai: boolean;
}
const { title, description, date, category, tags, lang, href, ai } = Astro.props;
---
<a href={href} class="article-link" aria-label={title} data-reveal>
  <article class="article-card">
    <div class="article-meta label-ui"><time datetime={date.toISOString()}>{formatDate(date, lang)}</time><span>{category} / {lang.toUpperCase()}</span></div>
    <div class="article-summary"><h3>{title}</h3><p>{description}</p><div class="article-tags label-ui">{tags.join(" / ")}{ai && <span title={t("articles.aiAssistedDescription")}> · {t("articles.aiAssisted")}</span>}</div></div>
    <ArrowUpRight class="article-arrow" size={22} />
  </article>
</a>
