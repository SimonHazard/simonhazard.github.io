<div class="orbital" aria-hidden="true">
  <div class="orbital-grid"></div>
  <svg class="orbital-drawing" viewBox="0 0 600 600" fill="none">
    <circle cx="300" cy="300" r="260" class="orbit-guide" />
    <path d="M300 15v40M300 545v40M15 300h40M545 300h40" class="orbit-guide" />
    <g class="orbit-rotation ambient-motion">
      <circle cx="300" cy="300" r="234" stroke="currentColor" stroke-width="2" stroke-dasharray="320 50 80 70" />
      <circle cx="300" cy="300" r="224" class="orbit-guide" stroke-dasharray="2 12" stroke-width="9" />
      <circle cx="300" cy="66" r="6" fill="currentColor" />
    </g>
    <g class="orbit-core">
      <circle cx="300" cy="300" r="182" class="orbit-guide" />
      {Array.from({length: 22}, (_, i) => {
        const y = 132 + i * 16;
        const width = Math.sqrt(Math.max(0, 172 ** 2 - (y - 300) ** 2));
        return <path d={`M${300 - width} ${y}H${300 + width}`} stroke="currentColor" stroke-opacity={0.12 + i * 0.025} stroke-width="1" />;
      })}
      <ellipse cx="300" cy="300" rx="75" ry="174" stroke="currentColor" stroke-opacity=".5" />
      <ellipse cx="300" cy="300" rx="132" ry="174" stroke="currentColor" stroke-opacity=".3" />
      <path d="M300 126v348" stroke="currentColor" stroke-opacity=".5" />
    </g>
    <g class="orbit-counter ambient-motion">
      <ellipse cx="300" cy="300" rx="280" ry="90" transform="rotate(-35 300 300)" stroke="currentColor" stroke-width="1.5" />
      <path d="m526 134 12-8-3 14z" fill="currentColor" />
    </g>
    <path d="M280 300h40M300 280v40" stroke="currentColor" />
  </svg>
</div>
