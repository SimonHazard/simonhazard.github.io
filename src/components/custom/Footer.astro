    <div class="footer-signature"><a href="/" class="footer-logo" aria-label="Simon Hazard — Home"><Monogram /></a><span class="label-ui">Always curious.<br />Always building.</span></div>
    <div class="footer-links"><a href="https://github.com/SimonHazard" target="_blank" rel="noopener noreferrer" class="text-link">GitHub <ArrowUpRight size={14} /></a><a href="https://ko-fi.com/simonhazard" target="_blank" rel="noopener noreferrer" class="text-link">Ko-fi <ArrowUpRight size={14} /></a><a href="/static/simon-hazard.pdf" download class="text-link">Resume <ArrowUpRight size={14} /></a></div>
    <div class="footer-bottom label-ui"><span>© {new Date().getFullYear()} Simon Hazard</span><Barcode /></div>
  </div>
</footer>
